{
  "description": "Which rule types each cakeshop route should get (my judgement), used only by tools/rules_eval.py. 'required': a reviewer would clearly write this rule. 'optional': reasonable, neither rewarded nor punished. Anything else counts as an extra rule. 'must' links a rule to a labelled bug or decoy: the rule needed to catch the bug (or to judge the decoy) in the next step; 'keywords' must appear in the rule text (any one of them, case-insensitive).",
  "routes": {
    "/account": {"required": ["who_may_call", "must_not_change", "csrf"], "optional": ["whose_data", "limits", "do_not_trust"],
      "must": [{"label": "V11", "type": "must_not_change", "keywords": ["admin", "role", "privilege"]},
               {"label": "V19", "type": "csrf", "keywords": []}]},
    "/admin/orders": {"required": ["who_may_call"], "optional": ["whose_data"],
      "must": [{"label": "V10", "type": "who_may_call", "keywords": ["admin"]}]},
    "/admin/stats": {"required": ["who_may_call"], "optional": ["limits", "do_not_trust"],
      "must": [{"label": "D05", "type": "who_may_call", "keywords": ["admin"]}]},
    "/admin/orders/<int:order_id>/status": {"required": ["who_may_call", "limits", "csrf"], "optional": ["do_not_trust", "whose_data", "must_not_change"],
      "must": [{"label": "V19", "type": "csrf", "keywords": []}]},
    "/register": {"required": ["csrf", "limits"], "optional": ["must_not_change", "do_not_trust", "who_may_call"],
      "must": [{"label": "V19", "type": "csrf", "keywords": []}]},
    "/login": {"required": ["do_not_trust", "csrf"], "optional": ["limits", "who_may_call"],
      "must": [{"label": "V12", "type": "do_not_trust", "keywords": ["next", "redirect"]},
               {"label": "V19", "type": "csrf", "keywords": []}]},
    "/logout": {"required": [], "optional": ["csrf", "who_may_call"], "must": []},
    "/orders": {"required": ["who_may_call", "whose_data"], "optional": [], "must": []},
    "/orders/<int:order_id>": {"required": ["who_may_call", "whose_data"], "optional": ["limits"],
      "must": [{"label": "V08", "type": "whose_data", "keywords": ["own", "belong", "user"]}]},
    "/orders/<int:order_id>/invoice": {"required": ["who_may_call", "whose_data"], "optional": ["limits", "do_not_trust"],
      "must": [{"label": "D07", "type": "whose_data", "keywords": ["own", "belong", "user"]}]},
    "/": {"required": [], "optional": [], "must": []},
    "/search": {"required": [], "optional": ["limits", "do_not_trust"], "must": []},
    "/product/<int:product_id>": {"required": [], "optional": ["limits"], "must": []},
    "/product/<int:product_id>/review": {"required": ["who_may_call", "csrf"], "optional": ["limits", "do_not_trust", "must_not_change"],
      "must": [{"label": "V19", "type": "csrf", "keywords": []}]},
    "/image": {"required": [], "optional": ["do_not_trust", "limits"], "must": []},
    "/thumbnail": {"required": [], "optional": ["do_not_trust", "limits"], "must": []},
    "/greeting": {"required": [], "optional": ["limits", "do_not_trust"], "must": []},
    "/cake-message/preview": {"required": [], "optional": ["limits", "do_not_trust"], "must": []},
    "/cart": {"required": [], "optional": ["do_not_trust", "limits"], "must": []},
    "/cart/add": {"required": ["csrf"], "optional": ["do_not_trust", "limits"],
      "must": [{"label": "V19", "type": "csrf", "keywords": []}]},
    "/checkout": {"required": ["who_may_call", "do_not_trust", "limits", "csrf"], "optional": ["whose_data", "must_not_change"],
      "must": [{"label": "V05", "type": "do_not_trust", "keywords": ["price", "total", "amount", "cost"]},
               {"label": "V06", "type": "limits", "keywords": ["quantity", "qty"]},
               {"label": "V19", "type": "csrf", "keywords": []}]}
  }
}
